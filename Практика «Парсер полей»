namespace TableParser;

[TestFixture]
public class FieldParserTaskTests
{
	public static void Test(string input, string[] expectedResult)
	{
		var actualResult = FieldsParserTask.ParseLine(input);
        ClassicAssert.AreEqual(expectedResult.Length, actualResult.Count);
		for (int i = 0; i < expectedResult.Length; ++i)
		{
            ClassicAssert.AreEqual(expectedResult[i], actualResult[i].Value);
		}
	}

    [TestCase("text", new[] { "text" })]
    [TestCase("", new string[0])]
    [TestCase("\"hello\"world", new[] { "hello", "world" })]
    [TestCase("'\"abc\"", new[] { "\"abc\"" })]
    [TestCase(@"""\\""", new[] { "\\" })]
    [TestCase("\"\\\"abc\\\"\"", new[] { "\"abc\"" })]
    [TestCase("'\\\'abc\\\''", new[] { "'abc'" })]
    [TestCase("\'\'", new[] { "" })]
    [TestCase("hello  world ", new[] { "hello", "world" })]
    [TestCase("\"'hello' world\"", new[] { "'hello' world" })]
    [TestCase("hello\"world\"", new[] { "hello", "world" })]
    [TestCase("' ", new[] { " " })]
    [TestCase("a \"bcd ef\" 'x y'",new [] { "a", "bcd ef", "x y" })]

    public static void RunTests(string input, string[] expectedOutput)
    {
        Test(input, expectedOutput);
    }
}

public class FieldsParserTask
{
    public static List<Token> ParseLine(string line)
    {
        var listToken = new List<Token>();
        var stringBuild = new StringBuilder();
        var index = 0;
        while (index < line.Length)
        {
            Token token; 
            if (line[index] == '\'' || line[index] == '\"' )
                token = ReadQuotedField(line, index);
            else if (line[index]==' ')
            {
                index++;
                continue;
            }
            else
                token = ReadField(line, index);

            listToken.Add(token);
            index += token.Length;
        }

        return listToken;
    }

	private static Token ReadField(string line, int startIndex)
	{
        var value = new StringBuilder();
        var index = startIndex;
        while (index < line.Length) 
        {   
            if (line[index] == '\'' || line[index] == '\"' || line[index] == ' ')
            {
                index++;
                break;
            }

            value.Append(line[index]);
            index++;
        }

        return new Token(value.ToString(), startIndex, value.Length);
	}

	public static Token ReadQuotedField(string line, int startIndex)
	{
		return QuotedFieldTask.ReadQuotedField(line, startIndex);
	}
}
